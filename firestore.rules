rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyId} {

      // Qualquer usuário autenticado pode checar se um código de família existe
      // (necessário para "criar" checar colisão e para "entrar" validar o código
      // antes de virar membro). Os dados aqui são só a lista de uids de membros,
      // nada sensível.
      allow read: if request.auth != null;

      // Qualquer usuário autenticado (mesmo anônimo) pode criar uma família nova.
      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members;

      // Duas formas de atualizar a família:
      // 1) "Entrar" = adicionar o próprio uid à lista de membros (máx. 5 pessoas).
      // 2) Membro já existente salvando seu próprio token de notificação (FCM),
      //    sem mexer em quem são os membros.
      allow update: if request.auth != null && (
        (resource.data.members.size() < 5
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members)
        ||
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
      );

      allow delete: if false;

      match /messages/{messageId} {
        // Só membros da família leem e enviam mensagens. Ninguém edita/apaga.
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
        allow update, delete: if false;
      }
    }
  }
}
